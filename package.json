{
  "name": "gadget-catalog",
  "version": "0.19.3",
  "description": "A react application for cataloging gadgets",
  "author": "Shibbir Ahmed",
  "license": "MIT",
  "scripts": {
    "start": "run-p webpack:development pm2:development",
    "pm2:development": "cross-env NODE_ENV=development yarn pm2 start server.js --watch --no-daemon --name gadget-catalog --ignore-watch public/uploads",
    "webpack:development": "cross-env NODE_ENV=development webpack --progress --watch --stats normal",
    "pm2:production": "cross-env NODE_ENV=production pm2 start server.js --name gadget-catalog",
    "webpack:production": "cross-env NODE_ENV=production webpack --progress",
    "production": "run-s webpack:production pm2:production",
    "test": "jest --detectOpenHandles",
    "seed": "node seeder.js",
    "eslint": "eslint src/**/*.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@reduxjs/toolkit": "^2.9.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cookie-signature": "^1.2.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-hbs": "^2.5.0",
    "fomantic-ui-css": "^2.9.4",
    "formik": "^2.4.6",
    "glob": "^11.0.3",
    "highcharts": "^12.4.0",
    "izitoast": "^1.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "prop-types": "^15.8.1",
    "query-string": "^9.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-intl": "^7.1.11",
    "react-redux": "^9.2.0",
    "react-router": "^7.9.3",
    "redux": "^5.0.1",
    "redux-promise-middleware": "^6.2.0",
    "semantic-ui-react": "3.0.0-beta.2",
    "validator": "^13.15.15",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.36.0",
    "@faker-js/faker": "^9.8.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "mini-css-extract-plugin": "^2.9.2",
    "npm-run-all": "^4.1.5",
    "pm2": "^6.0.13",
    "supertest": "^7.1.4",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "packageManager": "yarn@4.10.3"
}
